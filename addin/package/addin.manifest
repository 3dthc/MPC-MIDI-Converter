# MouseMIDI addin - drive MPC editing from a USB mouse. Plain assignments only (install.sh sources this as root).
ADDIN_ID=mousemidi
ADDIN_NAME="MouseMIDI"
ADDIN_SO=mousemidi.so
ADDIN_CONF=mousemidi.conf
ADDIN_DONE="MouseMIDI is on. Grid: scroll = value step, right-click = Erase, tap the middle button to latch Shift on/off (then left-click menu options or scroll for note length). Retune in /data/mpc-addins/mousemidi/mousemidi.conf - no reinstall."
