# MouseMIDI addin - drive MPC editing from a USB mouse. Plain assignments only (install.sh sources this as root).
ADDIN_ID=mousemidi
ADDIN_NAME="MouseMIDI"
ADDIN_SO=mousemidi.so
ADDIN_CONF=mousemidi.conf
ADDIN_DONE="MouseMIDI is on. Wheel steps values; right-click = Erase; middle or rear side button = Shift latch; front side button = Play. Auto-detects your mouse. Retune in /data/mpc-addins/mousemidi/mousemidi.conf - no reinstall."
