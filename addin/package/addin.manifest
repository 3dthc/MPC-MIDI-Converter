# MouseMIDI addin - drive MPC editing from a USB mouse. Plain assignments only (install.sh sources this as root).
ADDIN_ID=mousemidi
ADDIN_NAME="MouseMIDI"
ADDIN_SO=mousemidi.so
ADDIN_CONF=mousemidi.conf
ADDIN_DONE="MouseMIDI is on. Wheel scrolls the view and steps values; right-click = Erase; tap the middle button to latch Shift (then left-click menu options). Retune in /data/mpc-addins/mousemidi/mousemidi.conf - no reinstall."
